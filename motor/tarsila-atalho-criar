#!/bin/bash
# Cria o atalho curado (.desktop + ícone) para um pacote já instalado:
# /usr/share/tarsila/games (jogos) ou /usr/share/tarsila/applications
# (demais apps), com o ícone real do pacote copiado para
# /usr/share/tarsila/icons/<pacote>.<ext>.
#
# Universal: funciona para QUALQUER .deb instalado, com ou sem a Store.
# A classificação jogo/app usa o catálogo da Store quando presente e a
# Section oficial do Debian como fallback.
#
# Compartilhado pelo instalador de .deb avulso (tarsila-deb-instalar) e
# pela Tarsila Store (tarsila-pkg) — os dois rodam como root quando
# chamam isto, então aqui não mexe com sudo.
#
# Uso: tarsila-atalho-criar <pacote>
# Imprime no stdout o caminho de cada .desktop criado (um por linha).
set -euo pipefail

PKG="${1:?uso: tarsila-atalho-criar <pacote>}"

LOJA="/opt/tarsila-store/loja"
TARSILA_APPS="/usr/share/tarsila/applications"
TARSILA_GAMES="/usr/share/tarsila/games"
TARSILA_ICONS="/usr/share/tarsila/icons"

destino_curado() {
  # Jogo se aparecer no catálogo de jogos; app se aparecer no de apps.
  # Alguns pacotes não aparecem em nenhum dos dois (os catalog-*.js têm
  # avisos de "JSON truncado"); nesse caso usa a Section oficial do
  # Debian, que sempre existe.
  if [ -f "$LOJA/catalog/catalog-jogos.js" ] && \
     grep -q "\"pkg\"[[:space:]]*:[[:space:]]*\"$PKG\"" "$LOJA/catalog/catalog-jogos.js" 2>/dev/null; then
    echo "$TARSILA_GAMES"; return
  fi
  if [ -f "$LOJA/catalog/catalog-apps.js" ] && \
     grep -q "\"pkg\"[[:space:]]*:[[:space:]]*\"$PKG\"" "$LOJA/catalog/catalog-apps.js" 2>/dev/null; then
    echo "$TARSILA_APPS"; return
  fi
  local secao
  secao="$(apt-cache show "$PKG" 2>/dev/null | sed -n 's/^Section: //p' | head -n1)"
  if [[ "$secao" == "games" ]]; then
    echo "$TARSILA_GAMES"
  else
    echo "$TARSILA_APPS"
  fi
}

icone_do_pacote() {
  # O ícone nem sempre está nos arquivos do próprio pacote (pode vir de
  # um pacote "-data" irmão) — busca no sistema de ícones como um todo
  # (temas + pixmaps). Prefere SVG (escalável); senão, o PNG de maior
  # resolução disponível.
  local nome="$1" melhor="" melhor_tam=-1 arq tam
  while IFS= read -r arq; do
    [ -f "$arq" ] || continue
    if [[ "$arq" == *.svg ]]; then echo "$arq"; return 0; fi
    tam=0
    [[ "$arq" =~ /([0-9]+)x[0-9]+/ ]] && tam="${BASH_REMATCH[1]}"
    if (( tam > melhor_tam )); then melhor_tam=$tam; melhor="$arq"; fi
  done < <(find /usr/share/icons /usr/share/pixmaps -type f \
                \( -iname "${nome}.png" -o -iname "${nome}.svg" -o -iname "${nome}.xpm" \) \
                2>/dev/null)
  [ -n "$melhor" ] && echo "$melhor"
}

destino="$(destino_curado)"
mkdir -p "$destino" "$TARSILA_ICONS"

while IFS= read -r desktop; do
  [ -f "$desktop" ] || continue
  nome_icone="$(sed -n 's/^Icon=//p' "$desktop" | head -n1)"
  arquivo_icone=""
  if [[ "$nome_icone" == /* ]]; then
    [ -f "$nome_icone" ] && arquivo_icone="$nome_icone"
  elif [ -n "$nome_icone" ]; then
    arquivo_icone="$(icone_do_pacote "$nome_icone")"
  fi
  destino_desktop="$destino/$(basename "$desktop")"
  cp "$desktop" "$destino_desktop"
  chmod 644 "$destino_desktop"
  if [ -n "$arquivo_icone" ]; then
    destino_icone_arquivo="$TARSILA_ICONS/${PKG}.${arquivo_icone##*.}"
    cp "$arquivo_icone" "$destino_icone_arquivo"
    chmod 644 "$destino_icone_arquivo"
    sed -i "s|^Icon=.*|Icon=$destino_icone_arquivo|" "$destino_desktop"
  fi
  # marca o pacote dono (desinstalacao confiavel), notificacao de
  # inicio (cursor de "carregando" ao abrir) e as acoes do clique
  # direito no Dock (Tirar do Dock / Desinstalar)
  grep -q "^X-Package=" "$destino_desktop" || \
    sed -i "/^\[Desktop Entry\]/a X-Package=$PKG" "$destino_desktop"
  grep -q "^StartupNotify=" "$destino_desktop" || \
    sed -i "/^\[Desktop Entry\]/a StartupNotify=true" "$destino_desktop"
  if ! grep -q "tarsila-dock-item.sh" "$destino_desktop"; then
    if grep -q "^Actions=" "$destino_desktop"; then
      sed -i "s|^Actions=|Actions=tirar-dock;desinstalar;|" "$destino_desktop"
    else
      sed -i "/^\[Desktop Entry\]/a Actions=tirar-dock;desinstalar;" "$destino_desktop"
    fi
    cat >> "$destino_desktop" <<FIMACOES

[Desktop Action tirar-dock]
Name=Tirar do Dock
Exec=/usr/local/bin/tarsila-dock-item.sh remove $destino_desktop

[Desktop Action desinstalar]
Name=Desinstalar
Exec=/usr/local/bin/tarsila-app-uninstall.sh $destino_desktop
FIMACOES
  fi
  echo "$destino_desktop"
done < <(dpkg -L "$PKG" 2>/dev/null | grep -E "^/usr/share/applications/.*\.desktop$")
